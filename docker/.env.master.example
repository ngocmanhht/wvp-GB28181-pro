# ==============================================================================
# CẤU HÌNH MÁY CHỦ WVP MASTER (CONTROL PLANE)
# ==============================================================================

# 1. IP CỦA MÁY CHỦ WVP MASTER
# IP để ZLM Node kết nối bắn Webhook về (Bắt buộc phải là IP LAN hoặc IP Public mà Node ping được)
ZLM_HOOK_HOST=192.168.100.1

# 2. CẤU HÌNH CLUSTER JOIN TOKENS (BẢO MẬT GIA NHẬP CỤM)
# Danh sách token hợp lệ cho phép các Node ZLM gia nhập (phân tách bằng dấu phẩy)
MEDIA_SECRET=wvp_cluster_join_secret_key_2026,token_north_2026,token_south_2026,token_danang_2026

# 3. CẤU HÌNH BÁO HIỆU SIP (GB28181)
SIP_ShowIP=192.168.100.1
SIP_Port=8116
SIP_Domain=3402000000
SIP_Id=34020000002000000001
SIP_Password=wvp_sip_password

# 4. CỔNG WEB ADMIN NGINX
WebHttp=80
Stream_IP=27.71.24.106
