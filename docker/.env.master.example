# ==============================================================================
# CẤU HÌNH MÁY CHỦ WVP MASTER (CONTROL PLANE)
# ==============================================================================

# 1. THÔNG TIN ĐĂNG NHẬP CƠ SỞ DỮ LIỆU & CACHE
MYSQL_ROOT_PASSWORD=wvp_root_pwd_change_me
MYSQL_USER=wvp_user
MYSQL_PASSWORD=wvp_password_change_me
MYSQL_INNODB_BUFFER_POOL_SIZE=512M
REDIS_PWD=wvp_redis_pwd_change_me

# JVM Memory Tuning (Production: 2GB-4GB Heap recommended)
JAVA_OPTS=-Xms1024m -Xmx2048m -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/opt/ylcx/

# 2. IP CỦA MÁY CHỦ WVP MASTER
# IP để ZLM Node kết nối bắn Webhook về (Bắt buộc là IP LAN hoặc IP Public mà Node ping được)
ZLM_HOOK_HOST=127.0.0.1
# Cổng Nginx tiếp nhận webhook (/index/hook/)
ZLM_HOOK_PORT=80

# 3. CẤU HÌNH CLUSTER JOIN TOKENS (BẢO MẬT GIA NHẬP CỤM)
# Danh sách token hợp lệ cho phép các Node ZLM gia nhập (phân tách bằng dấu phẩy)
MEDIA_SECRET=wvp_cluster_join_secret_key_2026,token_north_2026,token_south_2026

# 4. CẤU HÌNH BÁO HIỆU SIP (GB28181)
# IP mà camera nhìn thấy để kết nối gửi SIP (IP LAN hoặc IP Public)
SIP_ShowIP=127.0.0.1
SIP_Port=8116
SIP_Domain=3402000000
SIP_Id=34020000002000000001
SIP_Password=wvp_sip_password_change_me

# 5. CỔNG WEB ADMIN NGINX
WebHttp=80
Stream_IP=127.0.0.1
