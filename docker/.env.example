# ==============================================================================
# WVP-GB28181-PRO Docker All-in-One Configuration Example
# ==============================================================================

# Database & Cache Credentials
MYSQL_ROOT_PASSWORD=wvp_root_pwd_change_me
MYSQL_USER=wvp_user
MYSQL_PASSWORD=wvp_password_change_me
MYSQL_INNODB_BUFFER_POOL_SIZE=512M

# Redis Password
REDIS_PWD=wvp_redis_pwd_change_me

# Cluster Join Token & Hooks
MEDIA_SECRET=wvp_cluster_join_secret_key_change_me
ZLM_HOOK_HOST=127.0.0.1
ZLM_HOOK_PORT=80

# JVM Memory Tuning (Production: 2GB-4GB Heap recommended)
JAVA_OPTS=-Xms1024m -Xmx2048m -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/opt/ylcx/

# Media Server (ZLMediaKit) Ports
MediaRtmp=10935
MediaRtsp=5540
MediaRtp=10000
ZLM_SECRET=wvp_media_secret_change_me

# Web / Nginx
WebHttp=80
WebHttps=8081

# IP Settings (Replace with your LAN IP or Public IP)
Stream_IP=127.0.0.1
SDP_IP=127.0.0.1

# SIP Signaling (GB28181)
SIP_ShowIP=127.0.0.1
SIP_Port=8116
SIP_Domain=3402000000
SIP_Id=34020000002000000001
SIP_Password=wvp_sip_password_change_me

# Records
RecordSip=true
RecordPushLive=false
